// Configuratie voor de agentic-coding stresstest.
// Dit bestand is JSON met // regelcommentaar; alles wat je hier verandert,
// wordt naast de resultaten opgeslagen zodat een run terug te herleiden is.
{
  // ---------------------------------------------------------------- server
  "endpoint": {
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key": null,
    "model": "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8",
    "metrics_url": "http://127.0.0.1:8000/metrics",
    "timeout_s": 300,
    "connect_timeout_s": 30,
    "verify_tls": true
  },

  // ------------------------------------------------------------- hardware
  // Nodig om de gemeten KV-cachebezetting (een percentage van de pool) om te
  // rekenen naar gigabytes, en dus om te kunnen zeggen of 72 GB of 64 GB ook
  // volstaat. Vul dit in voor de kaart waarop je meet.
  "hardware": {
    "gpu_name": "NVIDIA RTX PRO 6000 Blackwell",
    "vram_gb": 96.0,
    // Zelfde waarde als --gpu-memory-utilization waarmee je vLLM start.
    "gpu_memory_utilization": 0.90,
    // Gewichten van het model in het geheugen; Qwen3-Coder-30B-A3B in FP8 is
    // ongeveer 31 GB, plus wat activatie- en CUDA-overhead.
    "model_weights_gb": 33.0,
    // De attention-backend waarmee vLLM draaide. null betekent: vLLM koos zelf.
    // Dit hoort bij de resultaten omdat het de getallen beinvloedt -- op een
    // RTX PRO 6000 Blackwell kiest vLLM FlashInfer, en als die build de kaart
    // niet kent wijkt scripts/pod.sh uit naar TRITON_ATTN en zet dat hier neer.
    "attention_backend": null,
    // De KV-cache-dtype waarmee vLLM werkelijk draaide. Dit kan afwijken van
    // wat je meegaf: kan vLLM de FP8-cache op deze kaart niet bedienen, dan
    // wijkt scripts/pod.sh uit naar auto. Dat scheelt ruwweg een halvering van
    // het aantal sessies dat past, dus het hoort bij de uitkomst vermeld.
    "kv_cache_dtype": null,
    // Alternatieven waarmee de resultaten worden vergeleken in RESULTATEN.md.
    "alternatives": [
      {"name": "RTX PRO 5000 (72 GB)", "vram_gb": 72.0, "price_eur": 7602},
      {"name": "2x RTX 5090 (64 GB)", "vram_gb": 64.0, "price_eur": 10000},
      {"name": "RTX PRO 6000 (96 GB)", "vram_gb": 96.0, "price_eur": 37400}
    ]
  },

  // Vaste seed: dezelfde seed geeft dezelfde klas, dezelfde denktijden en
  // dezelfde bestandskeuze. Verander hem alleen bewust.
  "seed": 20250908,

  "request": {
    "temperature": 0.0,
    // ignore_eos maakt de lengte van elke agentstap exact max_tokens, zodat
    // de belasting reproduceerbaar is in plaats van afhankelijk van waar het
    // model toevallig stopt. Zet op false bij een server die vLLM niet is;
    // het harnas schakelt zelf terug als de server de vlag weigert.
    "ignore_eos": true,
    "extra_body": {}
  },

  // ---------------------------------------------------------------- corpus
  // Echte broncode, geen vulling: tokenverdeling en vooral prefix caching
  // hangen af van realistische, herhaalde prefixen.
  "corpus": {
    // Een naam of een lijst namen; meerdere projecten worden gecombineerd tot
    // een corpus van een paar duizend regels over Python, JavaScript en PHP.
    "project": ["django-realworld", "react-realworld", "laravel-realworld"],
    "cache_dir": "corpus_cache",
    // Het deel van het corpus dat het gedeelde projectskelet vormt: het blok
    // dat voor elke student byte-identiek is en dus cachehits over studenten
    // heen oplevert. Zet "shared_skeleton_files" om een vast aantal te kiezen.
    "shared_skeleton_fraction": 0.4,
    "shared_skeleton_files": null,
    // Vul dit in om een eigen checkout te gebruiken in plaats van te klonen.
    "local_path": null,
    "extensions": ".py,.js,.php,.md,.html"
  },

  "tokenizer": {
    // Exact tellen vereist de tokenizer van het model (pakket `tokenizers`).
    // Installeer dat: de contextgrootte is een as van de hele matrix, dus een
    // systematische fout erin verschuift de conclusie over het geheugen.
    "prefer_exact": true,
    // Pad naar een lokale tokenizer.json of modelmap; leeg = van Hugging Face
    // halen op basis van endpoint.model.
    "path": null,
    // Alleen gebruikt als er geen tokenizer beschikbaar is. Gemeten met
    // `stresstest calibrate` op dit corpus met de Qwen3-Coder-tokenizer:
    // grootste afwijking 3%. De veelgehoorde 3.5 komt uit Engels proza en
    // zit er bij broncode ruim 30% naast.
    "chars_per_token": 4.65
  },

  // ------------------------------------------------------------- gedragsmodel
  "behaviour": {
    // think_time_s wordt gelezen als ongeveer p10 en p90 van een lognormale
    // verdeling: echte denktijd heeft een lange staart, uniform trekken zou
    // juist de pieken wegpoetsen die we willen meten.
    "personas": [
      {
        "name": "doorpakker", "share": 0.15,
        "think_time_s": [20, 60], "steps_per_burst": [8, 15],
        "context_scale": [0.80, 1.00],
        "restart_probability": 0.02, "idle_probability": 0.00
      },
      {
        "name": "gemiddelde", "share": 0.45,
        "think_time_s": [60, 180], "steps_per_burst": [3, 8],
        "context_scale": [0.45, 0.70],
        "restart_probability": 0.05, "idle_probability": 0.02
      },
      {
        "name": "worstelaar", "share": 0.25,
        "think_time_s": [120, 480], "steps_per_burst": [2, 4],
        "context_scale": [0.20, 0.40],
        "restart_probability": 0.25, "idle_probability": 0.05
      },
      {
        "name": "afhaker", "share": 0.15,
        "think_time_s": [300, 1200], "steps_per_burst": [1, 3],
        "context_scale": [0.12, 0.30],
        "restart_probability": 0.15, "idle_probability": 0.30
      }
    ],
    // De activiteitsniveaus verschuiven de verdeling; het gedrag per persona
    // blijft hetzelfde.
    "activity_levels": {
      "rustig":    {"doorpakker": 0.05, "gemiddelde": 0.30, "worstelaar": 0.35, "afhaker": 0.30},
      "normaal":   {"doorpakker": 0.15, "gemiddelde": 0.45, "worstelaar": 0.25, "afhaker": 0.15},
      "intensief": {"doorpakker": 0.40, "gemiddelde": 0.45, "worstelaar": 0.12, "afhaker": 0.03}
    }
  },

  // ------------------------------------------------------------- beoordeling
  "grading": {
    "thresholds": {
      "ttft_p90_green_s": 20.0,
      "ttft_p90_amber_s": 45.0,
      "burst_p90_green_s": 90.0,
      "burst_p90_amber_s": 180.0,
      "decode_tps_p50_green": 12.0,
      "decode_tps_p50_amber": 6.0,
      "error_rate_green": 0.0,
      "error_rate_amber": 0.02,
      "preemptions_green": 0,
      "preemptions_amber": 5,
      "kv_usage_warn": 0.90,
      "prefix_cache_expectation": 0.60
    }
  },

  // ------------------------------------------------------------------- runs
  "run_defaults": {
    "warmup_s": 90,
    "measure_s": 300,
    "drain_s": 60,
    "gap_between_runs_s": 30,
    "arrival_window_s": 60,
    "progress_interval_s": 15,
    "metrics_interval_s": 2
  },

  "matrix": {
    "sweep": {
      "enabled": true,
      "students": [5, 10, 20, 30],
      "context_tokens": [8000, 32000, 64000, 100000],
      "activity": "normaal",
      "shared_fraction": 0.5
    },
    "activity_variation": {
      "enabled": true,
      "students": [10, 20],
      "levels": ["rustig", "intensief"],
      "context_tokens": 32000
    },
    "shared_variation": {
      "enabled": true,
      "students": 20,
      "context_tokens": [32000, 64000],
      "shared_fractions": [0.0, 0.5, 0.9]
    },
    "engine_variation": {
      "enabled": true,
      "students": 20,
      "context_tokens": 64000,
      "shared_fraction": 0.5,
      // Deze varianten vereisen dat je vLLM herstart met de genoemde vlaggen.
      // Het harnas wacht op je bevestiging voordat het zo'n run start.
      "variants": [
        {
          "name": "kv_fp8",
          "flags": "--kv-cache-dtype fp8 --max-num-seqs 32 --max-model-len 131072",
          "note": "FP8 KV-cache: ruwweg de helft van het cachegeheugen per token."
        },
        {
          "name": "kv_auto",
          "flags": "--kv-cache-dtype auto --max-num-seqs 32 --max-model-len 131072",
          "note": "Referentie zonder FP8-cache."
        },
        {
          "name": "seqs_16",
          "flags": "--kv-cache-dtype fp8 --max-num-seqs 16 --max-model-len 131072",
          "note": "Minder parallelle sequenties: minder preempties, langere wachtrij."
        },
        {
          "name": "seqs_64",
          "flags": "--kv-cache-dtype fp8 --max-num-seqs 64 --max-model-len 131072",
          "note": "Meer parallelle sequenties: kortere wachtrij, meer geheugendruk."
        },
        {
          "name": "len_65k",
          "flags": "--kv-cache-dtype fp8 --max-num-seqs 32 --max-model-len 65536",
          "note": "Korter contextvenster: meer blokken vrij voor parallelle sessies."
        }
      ]
    },
    "scenarios": {
      "enabled": true,
      "class_size": 20,
      "oversized_class": 30,
      "context_tokens": 32000,
      "cold_start_students": [20, 30],
      "cold_start_context_tokens": 12000,
      "cold_start_arrival_s": 120,
      "cold_start_measure_s": 240,
      "long_session_students": 6,
      "long_session_context_tokens": 110000,
      "silence_s": 600,
      "resume_measure_s": 240,
      "worst_case_context_tokens": 100000
    },
    "rampup": {
      "enabled": true,
      "start_students": 5,
      "max_students": 40,
      "step_interval_s": 120,
      // Hoeveel studenten er per stap bij komen. Op 1 duurt de klifzoeker
      // (max - start) x step_interval_s, bij deze waarden ruim een uur, en dat
      // is de duurste run van de hele matrix. Op 2 is hij half zo lang en is
      // het antwoord op twee studenten nauwkeurig -- ruim genoeg zolang de
      // klif ver van het startpunt ligt. Zet hem op 1 als je hem precies wilt
      // weten, en zoek dan met start_students dicht bij de verwachte grens.
      "step_students": 2,
      "context_tokens": 32000,
      "shared_fraction": 0.5,
      "activity": "normaal",
      "error_rate_limit": 0.02
    }
  },

  // ------------------------------------------------------- fase 2: de les
  "lesson": {
    "students": 20,
    "context_tokens": 32000,
    "shared_fraction": 0.5,
    "arrival_window_s": 120,
    // 1.0 = een echte les van negentig minuten. Zet op 0.1 voor een droogloop
    // van negen minuten om te controleren of alles werkt.
    "time_scale": 1.0
  },

  "output": {
    "directory": "results",
    "write_request_csv": true,
    "write_charts": true
  }
}
