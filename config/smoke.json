// Kleine, snelle configuratie om het harnas uit te proberen: tegen de
// meegeleverde mockserver, of tegen een klein model op een goedkope GPU.
// Draait de hele matrix in ongeveer twaalf minuten in plaats van vijf uur.
{
  "endpoint": {
    "base_url": "http://127.0.0.1:8000/v1",
    "model": "mock-model",
    "metrics_url": "http://127.0.0.1:8000/metrics",
    "timeout_s": 120
  },
  "seed": 20250908,
  // De mockserver hierboven doet alsof hij 40 GB heeft met 20 GB aan
  // gewichten; vul hier de waarden in van de kaart waarop je echt meet.
  "hardware": {
    "gpu_name": "mockserver",
    "vram_gb": 40.0,
    "gpu_memory_utilization": 0.90,
    "model_weights_gb": 20.0
  },
  // De mockserver heet "mock-model" en heeft geen eigen tokenizer, dus wijs
  // hier het model aan dat je straks echt gaat draaien. Zo tel je ook tijdens
  // het uitproberen exact, en meet je met dezelfde liniaal.
  "tokenizer": {
    "path": "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8",
    "chars_per_token": 4.65
  },
  "corpus": {
    "project": ["django-realworld", "react-realworld"],
    "shared_skeleton_fraction": 0.4
  },
  "run_defaults": {
    "warmup_s": 15,
    "measure_s": 45,
    "drain_s": 20,
    "gap_between_runs_s": 3,
    "arrival_window_s": 10,
    "progress_interval_s": 10,
    "metrics_interval_s": 1
  },
  "matrix": {
    "sweep": {
      "enabled": true,
      "students": [5, 10, 20],
      "context_tokens": [8000, 32000],
      "shared_fraction": 0.5
    },
    "activity_variation": {"enabled": true, "students": [10], "levels": ["intensief"]},
    "shared_variation": {"enabled": true, "students": 10, "context_tokens": [32000],
                         "shared_fractions": [0.0, 0.9]},
    "engine_variation": {"enabled": false},
    "scenarios": {
      "enabled": true,
      "class_size": 10,
      "oversized_class": 15,
      "cold_start_students": [10],
      "cold_start_measure_s": 45,
      "cold_start_arrival_s": 20,
      "long_session_students": 4,
      "long_session_context_tokens": 60000,
      "buildup_s": 45,
      "silence_s": 60,
      "resume_measure_s": 45,
      "worst_case_context_tokens": 48000
    },
    "rampup": {
      "enabled": true,
      "start_students": 3,
      "max_students": 12,
      "step_interval_s": 40,
      // Intensief, zodat er binnen zo'n korte stap genoeg instructies worden
      // afgerond om iets over te kunnen zeggen. In config/default.json staat
      // dit bewust op "normaal".
      "activity": "intensief",
      "context_tokens": 16000
    }
  },
  "lesson": {"students": 10, "time_scale": 0.1},
  "output": {"directory": "results"}
}
